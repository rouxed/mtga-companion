# Maintainer: Matias <matias@localhost>
pkgname=mtga-companion-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Native PyQt6 deck tracker and match history for Magic: The Gathering Arena"
arch=('x86_64')
url="https://github.com/rouxed/mtga-companion"
license=('custom')
depends=(
    'fuse2'
    'hicolor-icon-theme'
    'libxcb'
    'libxkbcommon'
    'xcb-util-cursor'
)
provides=('mtga-companion')
conflicts=('mtga-companion')
options=('!strip' '!debug')
source=(
    "mtga-companion-${pkgver}-x86_64.AppImage::https://github.com/rouxed/mtga-companion/releases/download/v${pkgver}/MTGA-Companion-${pkgver}-x86_64.AppImage"
    "mtga-companion.desktop"
    "mtga-companion.png"
)
sha256sums=(
    'ec15aacca6d074051288af00d1215a3c620645054f5d0f38a6d937bac6540e1d'
    '89e7614a6ceb100d964201bb620df0583ddd6bf6b218a3558b0cd8bfca1bc0b6'
    'ae5f2025e8cccc18ff8dedacff39bd4603eca9f2de623710f1effc7baf7d4c19'
)

package() {
    install -Dm755 "${srcdir}/mtga-companion-${pkgver}-x86_64.AppImage" \
        "${pkgdir}/usr/bin/mtga-companion"
    install -Dm644 "${srcdir}/mtga-companion.desktop" \
        "${pkgdir}/usr/share/applications/mtga-companion.desktop"
    install -Dm644 "${srcdir}/mtga-companion.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/mtga-companion.png"
}
